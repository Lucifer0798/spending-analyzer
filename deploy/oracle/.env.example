# Copy to .env (cp .env.example .env) and fill both in. .env stays on the server -- never commit it.

# The password you'll sign in with. Use something long; the login locks a caller out for 15
# minutes after 5 wrong guesses, but a strong password is the real protection.
APP_PASSWORD=

# The address the site is served at. Caddy gets a free HTTPS certificate for it automatically.
# With no domain of your own, use your VM's public IP with dots turned into dashes, plus
# .sslip.io -- e.g. for 129.146.12.34:
#   SITE_ADDRESS=129-146-12-34.sslip.io
# A free DuckDNS name (yourname.duckdns.org) or your own domain works too, once its DNS points at
# the VM's public IP.
SITE_ADDRESS=
